# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Neon dashboard -> your project -> Connect -> copy the POOLED connection string.
# Keep ?sslmode=require — Neon rejects unencrypted connections.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth signing secret. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL Better Auth uses to build callback/redirect URLs (server side).
BETTER_AUTH_URL="http://localhost:3000"

# Same origin, but readable in the browser by the auth client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
